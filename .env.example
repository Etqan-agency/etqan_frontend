# Django API root, INCLUDING /api (the site falls back to built-in content if it is unreachable).
# Production (API proxied under /etqan_api): https://www.etqanpp.com/etqan_api/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Canonical site origin used in metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://www.etqanpp.com

# Google Tag Manager container (GA4, Clarity and pixels are configured inside GTM). Empty = no tracking scripts.
NEXT_PUBLIC_GTM_ID=

# Cloudflare Turnstile site key for the contact form. Set it together with the API's TURNSTILE_SECRET_KEY — set both or neither:
# if the API has the secret but this is empty, the widget never renders and every lead is rejected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shared secret for on-demand revalidation (POST /api/revalidate, header x-revalidate-secret).
# Set the same value as REVALIDATE_SECRET in the Django API. Empty = endpoint always returns 401.
REVALIDATE_SECRET=

# Only when the backend serves media from S3/R2 behind a CDN (AWS_S3_CUSTOM_DOMAIN): that origin, e.g. https://media.etqanpp.com
NEXT_PUBLIC_MEDIA_URL=

# true = keep the whole deployment out of search engines (staging). Leave empty in production.
NEXT_PUBLIC_NOINDEX_SITE=
